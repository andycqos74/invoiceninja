# Paste into Portainer > Stack > Environment variables > "Advanced mode"
# Replace every CHANGE_ME before first deploy. Do NOT commit real values.

# --- Images (built by GitHub Actions) ---
GHCR_OWNER=CHANGE_ME_github_username_lowercase
# "latest", or pin to a built version e.g. 5.12.30
TAG=latest
HTTP_PORT=8013

# --- App ---
APP_URL=https://invoices.example.com
APP_KEY=CHANGE_ME_base64_key
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false
TRUSTED_PROXIES=*
PDF_GENERATOR=snappdf
PHANTOMJS_PDF_GENERATION=false
IS_DOCKER=true
SCOUT_DRIVER=null
FILESYSTEM_DISK=debian_docker

# --- Cache / queue / sessions ---
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ninja
DB_USERNAME=ninja
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password

# --- First-run admin (remove after first successful start) ---
IN_USER_EMAIL=CHANGE_ME@example.com
IN_PASSWORD=CHANGE_ME_admin_password

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=accounts@example.com
MAIL_FROM_NAME=Invoice Ninja

# --- Optional: GoCardless/Nordigen bank feeds ---
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=
